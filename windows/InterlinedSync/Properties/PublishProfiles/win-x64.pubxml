<?xml version="1.0" encoding="utf-8"?>
<!--
  Publish profile referenced by InterlinedSync.Package.wapproj when the MSIX
  packaging target needs to publish the WPF host before zipping it into the
  package. Framework-dependent so the installer stays small; users install the
  .NET 9 Desktop Runtime separately (or, if the MSIX itself depends on it via
  a Package Dependency, the Store handles it).
-->
<Project>
  <PropertyGroup>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Platform>x64</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <TargetFramework>net9.0-windows10.0.19041.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>
