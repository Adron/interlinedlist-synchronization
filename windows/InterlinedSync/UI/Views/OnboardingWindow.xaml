<Window x:Class="InterlinedSync.UI.Views.OnboardingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sign in to InterlinedList"
        Width="380" Height="320"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        ShowInTaskbar="True">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Sign in to InterlinedList"
                   FontSize="18"
                   FontWeight="SemiBold"
                   Margin="0,0,0,16" />

        <TextBlock Grid.Row="1" Text="Username" Margin="0,0,0,4" />
        <TextBox  Grid.Row="2"
                  x:Name="UsernameBox"
                  Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                  IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                  Margin="0,0,0,12" />

        <TextBlock Grid.Row="3" Text="Password" Margin="0,0,0,4" />
        <PasswordBox Grid.Row="4"
                     x:Name="PasswordBox"
                     PasswordChanged="PasswordBox_OnPasswordChanged"
                     IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                     Margin="0,0,0,12" />

        <TextBlock Grid.Row="5"
                   Text="{Binding ErrorMessage}"
                   Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}"
                   Foreground="#B00020"
                   TextWrapping="Wrap"
                   VerticalAlignment="Top"
                   Margin="0,0,0,12" />

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Width="80"
                    Margin="0,0,8,0"
                    IsCancel="True"
                    Click="CancelButton_OnClick" />
            <Button Content="Sign in"
                    Width="100"
                    IsDefault="True"
                    Command="{Binding SignInCommand}" />
        </StackPanel>
    </Grid>
</Window>
