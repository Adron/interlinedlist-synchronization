#!/bin/sh
set -e

case "$1" in
    remove|upgrade|deconfigure)
        echo "interlinedlist-sync: removing AppArmor profile"
        if command -v apparmor_parser >/dev/null 2>&1 && [ -d /sys/kernel/security/apparmor ]; then
            apparmor_parser -R /etc/apparmor.d/usr.bin.interlinedlist-sync 2>/dev/null || true
        fi
        ;;
esac

exit 0
