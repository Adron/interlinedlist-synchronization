#!/bin/sh
set -e

case "$1" in
    configure)
        echo "interlinedlist-sync: reloading sysctl drop-ins"
        if command -v sysctl >/dev/null 2>&1; then
            sysctl --system >/dev/null 2>&1 || true
        fi

        echo "interlinedlist-sync: loading AppArmor profile"
        if command -v apparmor_parser >/dev/null 2>&1 && [ -d /sys/kernel/security/apparmor ]; then
            apparmor_parser -r /etc/apparmor.d/usr.bin.interlinedlist-sync || true
        fi
        ;;
esac

exit 0
